# AI Platform API Configuration

# Environment mode: development, production, test
ENVIRONMENT=development
DEBUG=true

# Server configuration
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
PROJECT_NAME="AI Platform API"

# Allowed CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Clerk Authentication
# Obtain these from your Clerk dashboard: https://dashboard.clerk.com/
CLERK_SECRET_KEY=sk_test_placeholder_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_placeholder_publishable_key

# MongoDB Database Configuration
MONGODB_URL=mongodb://root:example@localhost:27017/axion?authSource=admin
MONGODB_DB_NAME=axion
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_POOL_SIZE=50

# Rate Limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=100

# Secrets Management (MOD-02 Envelope Encryption KEK - 32 bytes Base64)
# Generate with: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
AXION_MASTER_ENCRYPTION_KEY=X+8CEBICKjo0q2rCS0IAb6S5IkmQuAbQhOHlRuTVXos=

