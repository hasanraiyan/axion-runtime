{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Platform API",
    "description": "Official OpenAPI 3.1 specification for the AI Platform.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Root Service Health",
        "description": "Top-level health endpoint verifying service liveness.",
        "operationId": "get_root_health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse_HealthData_"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Service Health Check",
        "description": "Check the operational status, version, and uptime of the API service.",
        "operationId": "get_health_status",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse_HealthData_"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Get Authenticated User",
        "description": "Retrieve the current verified Clerk user profile and session identity.",
        "operationId": "get_current_authenticated_user",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Bearer token issued by Clerk",
              "title": "Authorization"
            },
            "description": "Bearer token issued by Clerk"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse_AuthenticatedUser_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiResponse_AuthenticatedUser_": {
        "properties": {
          "success": {
            "type": "boolean",
            "const": true,
            "title": "Success",
            "description": "Always true for successful responses",
            "default": true
          },
          "data": {
            "$ref": "#/components/schemas/AuthenticatedUser",
            "description": "Response payload"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Status message",
            "default": "Operation completed successfully"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "ApiResponse[AuthenticatedUser]"
      },
      "ApiResponse_HealthData_": {
        "properties": {
          "success": {
            "type": "boolean",
            "const": true,
            "title": "Success",
            "description": "Always true for successful responses",
            "default": true
          },
          "data": {
            "$ref": "#/components/schemas/HealthData",
            "description": "Response payload"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Status message",
            "default": "Operation completed successfully"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "ApiResponse[HealthData]"
      },
      "AuthenticatedUser": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Unique Clerk User ID (e.g. user_...)"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email",
            "description": "Primary email address"
          },
          "first_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Name",
            "description": "First name"
          },
          "last_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Name",
            "description": "Last name"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Roles",
            "description": "Assigned authorization roles"
          },
          "is_authenticated": {
            "type": "boolean",
            "title": "Is Authenticated",
            "description": "Authentication state",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "id"
        ],
        "title": "AuthenticatedUser"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthData": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Overall service status",
            "default": "ok"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "description": "Application version"
          },
          "environment": {
            "type": "string",
            "title": "Environment",
            "description": "Running environment"
          },
          "uptime_seconds": {
            "type": "number",
            "title": "Uptime Seconds",
            "description": "Service uptime in seconds"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp",
            "description": "Current ISO timestamp"
          }
        },
        "type": "object",
        "required": [
          "version",
          "environment",
          "uptime_seconds",
          "timestamp"
        ],
        "title": "HealthData"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "ClerkAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Clerk session JWT token. Pass 'Bearer <token>'."
      }
    }
  },
  "security": [
    {
      "ClerkAuth": []
    }
  ]
}