{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Platform API",
    "description": "Core API for the AI Platform. Provides health verification, auth verification, and OpenAPI contracts.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Root Service Health",
        "description": "Top-level health endpoint verifying service liveness.",
        "operationId": "get_root_health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse_HealthData_"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Service Health Check",
        "description": "Check the operational status, version, and uptime of the API service.",
        "operationId": "get_health_status",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse_HealthData_"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Get Authenticated User",
        "description": "Retrieve the current verified Clerk user profile, MongoDB sync state, and assigned role.",
        "operationId": "get_current_authenticated_user",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse_AuthenticatedUser_"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired, or invalid authorization token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/auth/users/{clerk_id}/role": {
      "put": {
        "tags": ["Authentication"],
        "summary": "Update User Role",
        "description": "Update the authorization role of a user ('admin' or 'user'). Requires admin role.",
        "operationId": "update_user_role",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "clerk_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Target Clerk User ID",
              "title": "Clerk Id"
            },
            "description": "Target Clerk User ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserRoleRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse_AuthenticatedUser_"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authorization token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Admin privileges required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Target user not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiErrorPayload": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Machine-readable error code"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Human-readable error summary"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": "array",
            "title": "Details",
            "description": "Detailed validation or sub-errors"
          }
        },
        "type": "object",
        "required": ["code", "message"],
        "title": "ApiErrorPayload"
      },
      "ApiErrorResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "const": false,
            "title": "Success",
            "description": "Always false for error responses",
            "default": false
          },
          "error": {
            "$ref": "#/components/schemas/ApiErrorPayload",
            "description": "Error details payload"
          }
        },
        "type": "object",
        "required": ["error"],
        "title": "ApiErrorResponse"
      },
      "ApiResponse_AuthenticatedUser_": {
        "properties": {
          "success": {
            "type": "boolean",
            "const": true,
            "title": "Success",
            "description": "Always true for successful responses",
            "default": true
          },
          "data": {
            "$ref": "#/components/schemas/AuthenticatedUser",
            "description": "Response payload"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Status message",
            "default": "Operation completed successfully"
          }
        },
        "type": "object",
        "required": ["data"],
        "title": "ApiResponse[AuthenticatedUser]"
      },
      "ApiResponse_HealthData_": {
        "properties": {
          "success": {
            "type": "boolean",
            "const": true,
            "title": "Success",
            "description": "Always true for successful responses",
            "default": true
          },
          "data": {
            "$ref": "#/components/schemas/HealthData",
            "description": "Response payload"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Status message",
            "default": "Operation completed successfully"
          }
        },
        "type": "object",
        "required": ["data"],
        "title": "ApiResponse[HealthData]"
      },
      "AuthenticatedUser": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Unique Database ID (MongoDB ObjectId)"
          },
          "clerk_id": {
            "type": "string",
            "title": "Clerk Id",
            "description": "Unique Clerk User identifier (user_...)"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email",
            "description": "Primary email address"
          },
          "first_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Name",
            "description": "First name"
          },
          "last_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Name",
            "description": "Last name"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url",
            "description": "Profile avatar image URL"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole",
            "description": "Assigned role: 'admin' or 'user'",
            "default": "user"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Roles",
            "description": "Assigned authorization roles"
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active",
            "description": "Account active state",
            "default": true
          },
          "is_authenticated": {
            "type": "boolean",
            "title": "Is Authenticated",
            "description": "Authentication state",
            "default": true
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At",
            "description": "Account creation timestamp"
          },
          "updated_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At",
            "description": "Account last update timestamp"
          }
        },
        "type": "object",
        "required": ["id", "clerk_id"],
        "title": "AuthenticatedUser"
      },
      "ErrorDetail": {
        "properties": {
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field",
            "description": "Field path causing the error"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Error message description"
          },
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Code",
            "description": "Specific error code"
          }
        },
        "type": "object",
        "required": ["message"],
        "title": "ErrorDetail"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthData": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Overall service status",
            "default": "ok"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "description": "Application version"
          },
          "environment": {
            "type": "string",
            "title": "Environment",
            "description": "Running environment"
          },
          "uptime_seconds": {
            "type": "number",
            "title": "Uptime Seconds",
            "description": "Service uptime in seconds"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp",
            "description": "Current ISO timestamp"
          },
          "database": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Database",
            "description": "Database connection status"
          }
        },
        "type": "object",
        "required": ["version", "environment", "uptime_seconds", "timestamp"],
        "title": "HealthData"
      },
      "UpdateUserRoleRequest": {
        "properties": {
          "role": {
            "$ref": "#/components/schemas/UserRole",
            "description": "New role to assign: 'admin' or 'user'"
          }
        },
        "type": "object",
        "required": ["role"],
        "title": "UpdateUserRoleRequest"
      },
      "UserRole": {
        "type": "string",
        "enum": ["admin", "user"],
        "title": "UserRole"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": ["loc", "msg", "type"],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "description": "Clerk Bearer JWT session token",
        "scheme": "bearer"
      }
    }
  },
  "tags": [
    {
      "name": "Health",
      "description": "System operational status, uptime, and liveness monitoring."
    },
    {
      "name": "Authentication",
      "description": "User profile verification and session identity management powered by Clerk."
    }
  ]
}
